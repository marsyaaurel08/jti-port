# =====================================================================
# .dockerignore - Jtiport
# =====================================================================

# --- Version control ---
.git
.gitignore
.gitattributes

# --- Dev/CI config ---
.github
.env
.env.*
!.env.example

# --- Node / frontend build artifacts ---
node_modules
*.log

# JANGAN exclude /public/build di sini karena multi-stage build:
# Stage frontend build assets ke /app/public/build,
# lalu di-COPY ke final stage. Yang perlu di-exclude hanya
# hasil build lokal agar tidak menimpa hasil build dari Docker.
# Uncomment baris ini kalau tidak pakai multi-stage:
# /public/build

# --- Laravel cache & storage ---
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*

# --- Test & dev tools ---
tests
.phpunit*
phpunit.xml
.phpunit.result.cache
phpstan.neon
psalm.xml

# --- Docker files ---
docker-compose*.yml
deploy.sh
rollback.sh

# --- Misc ---
*.md
README*
CHANGELOG*
.DS_Store
Thumbs.db

# --- Vendor (di-install ulang oleh composer di builder stage) ---
vendor

# =====================================================================
# TIDAK di-exclude:
# - docker/php/php.ini     → di-COPY oleh Dockerfile ke final stage
# - docker/php/www.conf    → di-COPY oleh Dockerfile ke final stage
# - package-lock.json      → dibutuhkan npm ci di frontend stage
# =====================================================================
