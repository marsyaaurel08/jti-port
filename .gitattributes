* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore

# Paksa LF untuk semua shell scripts dan config Linux
# agar tidak ada "exec format error" akibat CRLF dari Windows editor
*.sh        text eol=lf
*.conf      text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.env*      text eol=lf

# File yang boleh pakai CRLF (Windows-native)
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Binary — jangan disentuh
*.png       binary
*.jpg       binary
*.gif       binary
*.ico       binary
*.zip       binary
*.gz        binary